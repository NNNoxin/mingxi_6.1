{
  "name": "@mingxi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@mingxi/contracts": "workspace:*",
    "@mingxi/db": "workspace:*",
    "hono": "4.13.13",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mingxi/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "pino-pretty": "13.2.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
