#!/usr/bin/env sh
# 提交前门禁（CLAUDE.md §3）：密钥扫描、格式、lint、类型检查、单元测试全部通过才允许提交。
# 由根 package.json 的 prepare 脚本在 pnpm install 时启用（git config core.hooksPath .githooks）。
set -eu
if ! git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 -r pnpm exec secretlint --secretlintrc .secretlintrc.json; then
  echo "pre-commit：暂存的文件里疑似有密钥，已拒绝提交。密钥只能放在 .env 或部署平台的环境变量里（docs/02 §9）。" >&2
  exit 1
fi
if ! pnpm verify; then
  echo "pre-commit：pnpm verify 未通过，已拒绝提交。修复后重试。" >&2
  exit 1
fi
