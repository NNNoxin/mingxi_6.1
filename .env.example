# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，永远不要提交真实密钥。
# 本地默认值对应 infra/docker-compose.yml。

# ---- 服务进程 ----
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# 本进程启用的角色（逗号分隔）。当前已实现：api
MINGXI_PROCESS_ROLES=api

# ---- PostgreSQL ----
# 应用运行时连接（生产为 Neon 连接池地址）
DATABASE_URL=postgresql://mingxi:mingxi_local_only@127.0.0.1:5432/mingxi
# 迁移使用的直连地址（生产为 Neon 直连地址；本地与上面相同即可）
DATABASE_URL_DIRECT=postgresql://mingxi:mingxi_local_only@127.0.0.1:5432/mingxi

# ---- Redis（生产为 Render Key Value）----
REDIS_URL=redis://127.0.0.1:6379

# ---- 集成测试（指向可随意清空的独立库）----
TEST_DATABASE_URL=postgresql://mingxi:mingxi_local_only@127.0.0.1:5432/mingxi_test
TEST_REDIS_URL=redis://127.0.0.1:6379
