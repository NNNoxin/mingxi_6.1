# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，永远不要提交真实密钥。
# 本地默认值对应 infra/docker-compose.yml。

# ---- 服务进程 ----
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# 本进程启用的角色（逗号分隔）。当前已实现：api
MINGXI_PROCESS_ROLES=api

# ---- PostgreSQL ----
# 两个账号（docs/02 §3）：
# - DATABASE_URL：应用运行时账号，普通角色、mingxi_runtime 成员，受行级隔离约束（生产为 Neon 连接池地址）。
#   服务启动时会检查它不是超级用户、不带 BYPASSRLS，否则拒绝启动。
#   首次使用前执行一次 `pnpm --filter @mingxi/db db:migrate` 再执行 `pnpm --filter @mingxi/db db:runtime-role` 创建它。
# - DATABASE_URL_DIRECT：表 owner 的直连地址，只用于迁移与创建运行时账号（需要 CREATEROLE；生产为 Neon 直连地址）。
DATABASE_URL=postgresql://mingxi_app:mingxi_app_local_only@127.0.0.1:5432/mingxi
DATABASE_URL_DIRECT=postgresql://mingxi:mingxi_local_only@127.0.0.1:5432/mingxi

# ---- Redis（生产为 Render Key Value）----
REDIS_URL=redis://127.0.0.1:6379

# ---- 集成测试（指向可随意清空的独立库）----
# 测试准备阶段用 owner 执行迁移并按 TEST_APP_DATABASE_URL 创建运行时账号，业务与隔离测试都用运行时账号。
TEST_DATABASE_URL=postgresql://mingxi:mingxi_local_only@127.0.0.1:5432/mingxi_test
TEST_APP_DATABASE_URL=postgresql://mingxi_app:mingxi_app_local_only@127.0.0.1:5432/mingxi_test
TEST_REDIS_URL=redis://127.0.0.1:6379
