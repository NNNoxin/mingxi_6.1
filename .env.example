# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，永远不要提交真实密钥。
# 本地默认值对应 infra/docker-compose.yml。

# ---- 服务进程 ----
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# 本进程启用的角色（逗号分隔）。api：HTTP 接口；worker：后台任务（发件箱投递）；web：托管正式站静态产物。
# 零成本部署时一个进程同时承担 api,worker,web。本地开发通常不启用 web：正式站用 `pnpm --filter @mingxi/web dev`
# 跑在 4401 端口，把 /api 转发到本服务。
MINGXI_PROCESS_ROLES=api,worker
# 运营后台（docs/05）：两项同时填写即启用 /api/admin/*，留空则不启用。后台必须与正式站不同源（本地用另一个端口）。
# ADMIN_DATABASE_URL 是后台只读账号（mingxi_admin 成员），由 `pnpm --filter @mingxi/db db:roles` 创建；
# 第一个管理员用 `pnpm --filter @mingxi/server staff:grant <邮箱> admin "<原因>"` 授予。
MINGXI_ADMIN_URL=
ADMIN_DATABASE_URL=
# 启用 web 角色时必填：apps/web 构建产物目录（`pnpm --filter @mingxi/web build` 生成 apps/web/out）。
MINGXI_WEB_ROOT=

# ---- PostgreSQL ----
# 两个账号（docs/02 §3）：
# - DATABASE_URL：应用运行时账号，普通角色、mingxi_runtime 成员，受行级隔离约束（生产为 Neon 连接池地址）。
#   服务启动时会检查它不是超级用户、不带 BYPASSRLS，否则拒绝启动。
#   首次使用前执行一次 `pnpm --filter @mingxi/db db:migrate` 再执行 `pnpm --filter @mingxi/db db:roles` 创建它（同时按 ADMIN_DATABASE_URL 创建后台只读账号）。
# - DATABASE_URL_DIRECT：表 owner 的直连地址，只用于迁移与创建运行时账号（需要 CREATEROLE；生产为 Neon 直连地址）。
DATABASE_URL=postgresql://mingxi_app:mingxi_app_local_only@127.0.0.1:5432/mingxi
DATABASE_URL_DIRECT=postgresql://mingxi:mingxi_local_only@127.0.0.1:5432/mingxi

# ---- 认证（Better Auth）----
# 正式站对外地址：邮件里的链接、可信来源（CSRF 校验）、Cookie 都以它为准。
# 开发时是 apps/web 的开发服务器地址，它把 /api 转发到本服务（同源，见 docs/02 §2.3）。
MINGXI_PUBLIC_URL=http://localhost:4401
# 本服务前面有几层会追加 X-Forwarded-For 的可信反向代理。登录限流按客户端地址计数，地址只取这几层代理追加的部分，
# 客户端自己伪造的 X-Forwarded-For 不起作用。直连为 0；部署平台的负载均衡算一层。填错的后果：
# 填小了，所有用户共用代理的地址、一起被限流；填大了，客户端可以伪造地址绕过限流。上线前按平台文档与实测核对。
MINGXI_TRUSTED_PROXY_HOPS=0
# 会话 Cookie 签名与第三方令牌加密的密钥，至少 32 个字符。必须自己生成：openssl rand -base64 32
BETTER_AUTH_SECRET=
# 第三方登录：ID 与密钥成对填写即启用，留空即不启用。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 邮件（验证邮箱、找回密码）----
# smtp：真实投递，需要 SMTP_URL（任意服务商的 SMTP，例如 smtps://用户名:口令@smtp.example.com:465）。
# log：不投递，只把邮件内容（含链接）写进本机日志，仅限本地开发；生产环境会拒绝启动。
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM="明晰 <no-reply@localhost>"

# ---- Redis（生产为 Render Key Value）----
REDIS_URL=redis://127.0.0.1:6379

# ---- 集成测试（指向可随意清空的独立库）----
# 测试准备阶段用 owner 执行迁移，并按 TEST_APP_DATABASE_URL、TEST_ADMIN_DATABASE_URL 创建运行时账号与后台只读账号；
# 业务与隔离测试都用运行时账号，后台读取用后台只读账号。
TEST_DATABASE_URL=postgresql://mingxi:mingxi_local_only@127.0.0.1:5432/mingxi_test
TEST_APP_DATABASE_URL=postgresql://mingxi_app:mingxi_app_local_only@127.0.0.1:5432/mingxi_test
TEST_ADMIN_DATABASE_URL=postgresql://mingxi_admin_app:mingxi_admin_app_local_only@127.0.0.1:5432/mingxi_test
TEST_REDIS_URL=redis://127.0.0.1:6379
