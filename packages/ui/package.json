{
  "name": "@mingxi/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "明晰 demo 5（基准提交 81f92d7）的界面组件与样式，原样迁移；改动登记见 BASELINE.md",
  "exports": {
    "./components/*.css": "./src/components/*.css",
    "./components/*": {
      "types": "./dist/types/components/*.d.ts",
      "default": "./src/components/*.tsx"
    },
    "./data-source/port": {
      "types": "./dist/types/data-source/port.d.ts",
      "default": "./src/data-source/port.ts"
    },
    "./data-source/context": {
      "types": "./dist/types/data-source/context.d.ts",
      "default": "./src/data-source/context.tsx"
    },
    "./lib/*": {
      "types": "./dist/types/lib/*.d.ts",
      "default": "./src/lib/*.ts"
    },
    "./styles/*.css": "./src/styles/*.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "tailwindcss": "4.2.1"
  },
  "peerDependencies": {
    "next": "16.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "next": "16.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "6.0.3"
  }
}
