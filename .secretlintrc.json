{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "options": {
            "allows": ["/^postgresql:\\/\\/[a-z]+:[a-z]+_(local|ci)_only@127\\.0\\.0\\.1:\\d+\\/[a-z_]+$/"]
          }
        }
      ]
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Google API Key（Gemini 等，AIza 开头）",
            "pattern": "/AIza[0-9A-Za-z_-]{35}/"
          },
          {
            "name": "Google API Key（新格式，AQ. 开头）",
            "pattern": "/\\bAQ\\.[0-9A-Za-z_-]{40,}/"
          },
          {
            "name": "OpenAI 兼容格式的密钥（DeepSeek、硅基流动等）",
            "pattern": "/\\bsk-[A-Za-z0-9]{32,}\\b/"
          },
          {
            "name": "Tavily API Key",
            "pattern": "/\\btvly-[A-Za-z0-9_-]{20,}\\b/"
          }
        ]
      }
    }
  ]
}
